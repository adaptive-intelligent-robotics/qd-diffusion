Bootstrap: docker
From: ubuntu:22.04

%labels
	Author hnj21@imperial.ac.uk

%help
	Use QD for latent exploration of diffusion models. 

%environment
	# Activate virtual environment permanently
	export VIRTUAL_ENV="/venv"
	export _OLD_VIRTUAL_PATH="$PATH"
	export PATH="$VIRTUAL_ENV/bin:$PATH"

    # Add submodules to python path
    export PYTHONPATH=/workspace/src/QDax:$PYTHONPATH
	export PYTHONPATH=/workspace/src/APDDv2:$PYTHONPATH

	# System
	export TZ=Europe/London
	export OPENBLAS_NUM_THREADS=1

%post
	export DEBIAN_FRONTEND=noninteractive

	# Update and install required libraries
	apt update
	apt install -y wget git software-properties-common tmux

	# Install C compiler
	apt install -y python3-dev build-essential nvidia-cuda-toolkit

	# Install Python
	add-apt-repository ppa:deadsnakes/ppa
	apt install -y python3.10 python3.10-venv

	# Create a virtual environment
	python3.10 -m venv /venv
	. /venv/bin/activate
	python -m ensurepip
	pip install --upgrade pip setuptools wheel

	# Set up workspace
	mkdir /workspace/ && cd /workspace/

	# Clone repository to /project/
	git clone https://{{ gitlab_user }}:{{ gitlab_token }}@gitlab.doc.ic.ac.uk/AIRL/research_projects/hannah_janmohamed/latent_exploration.git src/ && cd src/
	git checkout {{ commit }}

# 1. Install all the general requirements FIRST
	# This will install the "wrong" torch, but we will fix it in the next step
	pip install -r requirements.txt
	
	# 2. OVERWRITE everything with the correct CUDA-versioned binaries
	# We use --force-reinstall to make sure the +cu121 versions stick
	pip install --force-reinstall \
		torch==2.5.1+cu121 \
		torchvision==0.20.1+cu121 \
		torchaudio==2.5.1+cu121 \
		xformers==0.0.28.post3 \
		--extra-index-url https://download.pytorch.org/whl/cu121

	# 3. Install remaining extras
	pip install pytorch-fid torchmetrics
	pip install --upgrade diffusers[flax]

%runscript
	# Run main
	python /workspace/src/main.py "$@"